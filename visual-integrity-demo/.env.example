# Local orchestrator (never commit real values)
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/m2moiz/hack-raise
CURSOR_STARTING_REF=main
CURSOR_CLOUD_ENV_NAME=hack-raise-testbed
CURSOR_MODEL_ID=composer-2.5

# Cloud / runner test configuration (non-secret, injected per run)
HACK_RAISE_RUN_ID=
HACK_RAISE_SCENARIO_ID=
HACK_RAISE_ROLE=user
HACK_RAISE_TESTPAD_BASE_URL=
HACK_RAISE_ARTIFACT_DIR=.hack-raise/runs

# Optional explicit profile override: local-dev | cloud-repo | cloud-env
# HACK_RAISE_PROFILE=cloud-repo
