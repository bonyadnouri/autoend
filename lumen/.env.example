# Lumen UI — copy to .env.local
# cp .env.example .env.local
#
# Get keys from Supabase → Project Settings → API

# --- React app (browser-safe — VITE_ prefix exposes these to the client) ---

# Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# anon / publishable key (safe for the browser with demo RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Database migrations only (npm run db:migrate) — not used by the React app ---

# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_REGION=eu-west-1

# --- autoend CLI (NOT here — put in autoend/.env or your target repo's .env) ---
#
# The CLI runs server-side and uses different variable names (no VITE_ prefix):
#   CURSOR_API_KEY
#   SUPABASE_URL              (same URL as VITE_SUPABASE_URL)
#   SUPABASE_SERVICE_ROLE_KEY (for evidence Storage — never put in .env.local)
#
# See autoend/.env.example in the autoend repo.
