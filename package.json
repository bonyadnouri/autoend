{
  "name": "autoend",
  "version": "0.0.1",
  "description": "Agent-powered end-to-end testing: initiate a Run, agents test your app, review a video-backed Report.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "autoend": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@cursor/sdk": "^1.0.23",
    "agent-browser": "^0.31.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
