{
  "name": "@bonyadnouri/autoend",
  "version": "0.1.2",
  "description": "Agent-powered end-to-end testing: initiate a Run, agents test your app, review a video-backed Report.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonyadnouri/autoend.git"
  },
  "homepage": "https://github.com/bonyadnouri/autoend#readme",
  "bugs": "https://github.com/bonyadnouri/autoend/issues",
  "keywords": [
    "e2e",
    "testing",
    "agents",
    "playwright",
    "browser-automation",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "autoend": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/cli.js",
    "./run": "./dist/run/run.js",
    "./stream": "./dist/stream/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:mini": "tsx bench/run-mini.ts",
    "bench:grafana": "tsx bench/grafana/run-grafana.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@cursor/sdk": "^1.0.23",
    "@supabase/supabase-js": "^2.45.0",
    "agent-browser": "^0.31.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
