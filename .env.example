# autoend — copy to .env in the directory where you RUN the CLI
# cp .env.example .env
#
# Get keys from:
#   Cursor API key     → https://cursor.com/dashboard → API Keys
#   Supabase URL/keys  → https://supabase.com/dashboard → Project Settings → API

# Required for exploration (agents discover new flows)
CURSOR_API_KEY=

# Required to publish run results to the Lumen Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# REQUIRED for hosted video + screenshots in the Lumen UI.
# Supabase → Project Settings → API → service_role (click Reveal, copy secret)
# Never commit. Never use in the React app (no VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback if service role is not set — table writes work (open RLS demo),
# but Storage bucket creation/upload usually fails with anon/publishable key only.
# SUPABASE_ANON_KEY=sb_publishable_...
